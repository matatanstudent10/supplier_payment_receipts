<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de Lista -->
    <record id="view_supplier_payment_receipt_tree" model="ir.ui.view">
        <field name="name">supplier.payment.receipt.tree</field>
        <field name="model">supplier.payment.receipt</field>
        <field name="arch" type="xml">
            <tree string="Comprobantes de Egreso" decoration-info="state == 'draft'" decoration-success="is_reconciled == True" decoration-danger="is_reconciled == False"  decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="journal_id"/>
                <field name="store_id"/>
                <field name="amount_total" sum="Total" widget="monetary"/>
                <field name="is_multiple_payment" widget="boolean_toggle"/>
                <field name="is_reconciled" widget="boolean_toggle" readonly="1" />
                <field name="currency_id" invisible="1"/>
                <field name="is_reversed" widget="boolean_toggle" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'posted'" decoration-danger="state == 'cancel'"/>
                <field name="payment_id" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Vista de Formulario Original -->
    <record id="view_supplier_payment_receipt_form" model="ir.ui.view">
        <field name="name">supplier.payment.receipt.form</field>
        <field name="model">supplier.payment.receipt</field>
        <field name="arch" type="xml">
            <form string="Comprobantes de Pago" duplicate="false">
                <header>
                    <!-- Botones organizados por funcionalidad -->
                    <button type="object" 
                            string='CARGAR LÍNEAS' 
                            name="action_load_invoices" 
                            attrs="{'invisible': ['|',('state', '!=', 'draft'),('is_multiple_payment', '=', False)]}"
                            class="btn-warning"
                            icon="fa-download"/>
                            
                    <button name="action_confirm" 
                            string="Confirmar" 
                            type="object" 
                            class="oe_highlight" 
                            icon="fa-check-circle"
                            attrs="{'invisible': ['|',('state', '!=', 'draft'),('is_multiple_payment', '=', False)]}"/>
                            
                    <button name="action_confirm_payment_advance" 
                            string="Confirmar Anticipo" 
                            type="object" 
                            class="oe_highlight" 
                            icon="fa-money"
                            attrs="{'invisible': ['|',('state', '!=', 'draft'),('is_multiple_payment', '=', True)]}"/>
                            
                    <button name="action_cancel" 
                            string="CANCELAR" 
                            confirm="¿Estás seguro de que deseas cancelar este recibo?"
                            type="object" 
                            class="btn-danger"
                            icon="fa-times-circle"
                            groups="supplier_payment_receipts.admin_treasury_financial"
                            attrs="{'invisible': [('state', '!=', 'posted')]}"/>
                            
                    <button name="action_set_to_draft" 
                            string="Volver a Borrador" 
                            type="object" 
                            icon="fa-undo"
                            groups="supplier_payment_receipts.admin_treasury_financial"
                            attrs="{'invisible': [('state', '!=', 'cancel')]}"/>
                            
                    <button name="action_reverse_payment" 
                            string="Generar Reversión" 
                            type="object" 
                            class="oe_highlight"
                            icon="fa-exchange"
                            attrs="{'invisible': ['|',('state', '!=', 'posted'),('is_reversed','=',True)]}"
                            groups="supplier_payment_receipts.admin_treasury_financial"/>

                    <button name="action_export_excel_detail" 
                            type="object" 
                            string="Exportar Detalle Excel" 
                            class="btn-secondary" 
                            icon="fa-file-excel-o" 
                            attrs="{'invisible': ['|',('state', '!=', 'posted'),('is_multiple_payment', '=', False)]}"
                            help="Exportar el detalle completo del comprobante en formato Excel"/>

                    <!-- Botones para impresión de cheques -->
                    <button name="action_print_checks" 
                            string="Imprimir Cheque" 
                            type="object" 
                            class="btn-primary"
                            icon="fa-print"
                            attrs="{'invisible': ['|', '|', '|', ('payment_method_code', '!=', 'check_printing'), ('state', '!=', 'posted'), ('payment_id', '=', False), ('impreso', '=', True)]}"/>

                    <button name="action_reprint_checks" 
                            string="Reimprimir Cheque" 
                            type="object"
                            class="btn-secondary"
                            icon="fa-print"
                            attrs="{'invisible': ['|', '|', '|', ('payment_method_code', '!=', 'check_printing'), ('state', '!=', 'posted'), ('payment_id', '=', False), ('impreso', '!=', True)]}"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                
                <!-- Campos invisibles -->
                <group invisible="1">
                    <field name="company_id"/>
                    <field name="payment_id" readonly="1"/>
                    <field name="is_multiple_payment"/>
                    <field name="is_reconciled" readonly="1"/>
                    <field name="invoices_count" readonly="1"/>
                    <field name="is_reversed"/>
                    <field name="payment_method_code"/>
                    <field name="available_payment_method_line_ids"/>
                    <field name="currency_id"/>
                    <field name="payment_term_text"/>
                    <field name="has_advance_payment"/>
                    <field name="impreso"/>
                </group>

                <div attrs="{'invisible': ['|','|',('state', '!=', 'draft'),('has_advance_payment', '=', False),('partner_id', '=', False)]}" class="alert alert-danger text-center o_form_header" role="alert" style="margin-bottom: 0px;">
                    <div>
                        <strong>¡Este Proveedor tiene anticipos pendientes por conciliar, por favor verifique en el boton de cartera Proveedor!</strong>
                    </div>
                    <div>
                        <strong>Anticipos: <span><field name="advances_payment_text" readonly="1" nolabel="1"/></span></strong>
                    </div>
                </div>


                <!-- Alerta de reversión -->
                <div attrs="{'invisible': [('is_reversed', '=', False)]}" 
                    class="alert alert-danger text-center o_form_header" 
                    role="alert" 
                    style="margin-bottom: 15px; border-left: 4px solid #d32f2f;">
                    <i class="fa fa-exclamation-triangle" title="Advertencia" style="margin-right: 8px;"/>
                    <strong>¡Atención!</strong> Este documento presenta un asiento de reversión
                </div>    

                <div attrs="{'invisible': ['|','|',('state', '!=', 'draft'),('payment_term_text', '!=', 'Pago inmediato'),('partner_id', '=', False)]}"
                    class="alert alert-danger text-center o_form_header" role="alert" style="margin-bottom: 0px;">
                    <div>
                        <strong>¡Este Proveedor es de Pago inmediato!</strong>
                    </div>
                </div>	

                <div attrs="{'invisible': ['|',('state', '!=', 'draft'),('is_multiple_payment', '=', True)]}"
                    class="alert alert-warning text-center o_form_header" role="alert" style="margin-bottom: 0px;">
                    <div>
                        <strong>¡Estas Creando un comprobante de egreso como anticipo!</strong>
                    </div>
                </div>	


                <sheet>
                    <!-- Botones de estadísticas -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_payment" 
                            class="oe_stat_button" 
                            icon="fa-dollar" 
                            type="object" 
                            attrs="{'invisible': ['|',('state', '!=','posted'),('payment_id', '=',False)]}" 
                            string="Ver Pago">
                        </button>
                        
                        <button name="action_open_account_move" 
                            class="oe_stat_button" 
                            icon="fa-file-text-o" 
                            type="object" 
                            attrs="{'invisible': ['|',('state', '!=','posted'),('payment_id', '=',False)]}" 
                            string="Asiento Contable">
                        </button>
                        
                        <button name="open_invoices_list" 
                            class="oe_stat_button"
                            icon="fa-bars"
                            type="object" 
                            attrs="{'invisible': ['|',('state', '!=','posted'),('invoices_count','=',0)]}">
                            <field name="invoices_count"/>
                            <span>Facturas</span>
                        </button>
                        
                        <button name="action_open_move_reverse"
                            class="oe_stat_button" 
                            icon="fa-exchange" 
                            type="object"
                            attrs="{'invisible': [('is_reversed', '=',False)]}" 
                            string="Asiento de Reversión">
                        </button>                       
                    </div>

                    <!-- Ribbons de estado -->
                    <widget name="web_ribbon" 
                            style="text-align: left;" 
                            title="CONCILIADO" 
                            bg_color="bg-success"
                            attrs="{'invisible': ['|',('state','!=','posted'),('is_reconciled','=',False)]}"/>
                            
                    <widget name="web_ribbon" 
                            bg_color="bg-danger" 
                            style="text-align: left;" 
                            title="NO CONCILIADO"  
                            attrs="{'invisible': ['|',('state','!=','posted'),('is_reconciled','=',True)]}"/>

                    <!-- Título del documento -->
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>


                    <group attrs="{'invisible':[('is_multiple_payment','=',True)]}">
                        <group>
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="date"/>
                            <field name="currency_id" options='{"no_open": True,"no_create": 1, "no_create_edit": 1}' groups="base.group_multi_currency"/>
                            <field name="amount_total" attrs="{'readonly': [('state','!=','draft')]}"/>
                            <field name="check_amount_in_words"
                                attrs="{'invisible': [('payment_method_code', '!=', 'check_printing')]}"
                            />   
                            <field name="sellos"  
                                widget="radio" 
                                options="{'horizontal': True}" 
                                attrs="{'readonly': [('state','!=','draft')],'invisible':[('payment_method_code', '!=', 'check_printing')]}"/>
                            <field name="memo" placeholder="Notas adicionales sobre el anticipo..."/>
                        </group>
                        <group>
                            <field name="store_id" domain="[('name','not in',['EMPAQUETADURAS','006 PRODUCCION'])]" required="1" options='{"no_open": True,"no_create": 1, "no_create_edit": 1}'/>
                            <field name="analytic_account_id" required="1" options='{"no_open": True,"no_create": 1, "no_create_edit": 1}'/>
                            <field name="journal_id" options='{"no_open": True,"no_create": 1, "no_create_edit": 1}'/>                         
                            <field name="destination_account_id" required="1" options='{"no_open": True,"no_create": 1, "no_create_edit": 1}'/>
                            <field name="payment_method_line_id" 
                                options='{"no_open": True,"no_create": 1, "no_create_edit": 1}' 
                                attrs="{'readonly': [('state','!=','draft')]}"/>
                            <field name="is_multiple_payment" string="Pago Múltiple"
                                attrs="{'readonly': [('state','!=','draft')]}"
                                widget="boolean_toggle"/>
                        </group>
                    </group>
 

                    <!-- INFORMACIÓN PRINCIPAL DEL RECIBO -->
                    <group name="main_info" style="margin-bottom: 10px;" attrs="{'invisible':[('is_multiple_payment','=',False)]}">
                        <group name="left_info" string="Información del Cliente">
                            <field name="partner_id" 
                                options="{'no_create': True, 'no_create_edit': True}" 
                                style="font-weight: bold;"
                                attrs="{'readonly': [('state','!=','draft')]}"/>
                           
                            <field name="date" 
                                attrs="{'readonly': [('state','!=','draft')]}"/>
                            <field name="journal_id" 
                                options='{"no_open": True,"no_create": 1, "no_create_edit": 1}'
                                attrs="{'readonly': [('state','!=','draft')]}"/>
                            <field name="payment_method_line_id" 
                                options='{"no_open": True,"no_create": 1, "no_create_edit": 1}' 
                                attrs="{'readonly': [('state','!=','draft')]}"/>
                            <field name="destination_account_id"  
                                required="1"
                                options='{"no_open": True,"no_create": 1, "no_create_edit": 1}'
                                attrs="{'readonly': [('state','!=','draft')],'invisible':[('is_multiple_payment','=',True)]}"/>
                        </group>
                        
                        <group name="right_info" string="Configuración del Recibo">
                            <field name="is_multiple_payment" 
                                string="Pago Múltiple"
                                attrs="{'readonly': [('state','!=','draft')]}"
                                widget="boolean_toggle"/>

                            <field name="reconcilable_accounting_entries" 
                                attrs="{'readonly': [('state','!=','draft')],'invisible': ['|',('partner_id','=',False),('is_multiple_payment','=',False)]}"
                                widget="boolean_toggle"/>

                            <field name="correria" 
                                attrs="{'invisible': ['|',('partner_id','=',False),('is_multiple_payment','=',False)]}"
                                widget="boolean_toggle"/>
                                
                            <field name="apply_discount" 
                                attrs="{'readonly': [('state','!=','draft')],'invisible': ['|',('partner_id','=',False),('is_multiple_payment','=',False)]}"
                                widget="boolean_toggle"/>

                            <field name="discount" 
                                attrs="{'readonly': [('state','!=','draft')],'invisible': [('apply_discount','=',False)]}"
                                />

                        </group>
                    </group>

                    <!-- INFORMACIÓN DE PAGO -->
                    <group name="payment_info" string="Detalles del Pago" style="margin-bottom: 10px;" attrs="{'invisible':[('is_multiple_payment','=',False)]}">
                        <group name="payment_left">

                            <field name="store_id" 
                                domain="[('name','not in',['EMPAQUETADURAS','006 PRODUCCION'])]" 
                                required="1" 
                                options='{"no_open": True,"no_create": 1, "no_create_edit": 1}'
                                attrs="{'readonly': [('state','!=','draft')]}"/>
                                
                            <field name="analytic_account_id" 
                                required="1" 
                                options='{"no_open": True,"no_create": 1, "no_create_edit": 1}'
                                attrs="{'readonly': [('state','!=','draft')]}"/>

                            <field name="sellos"  
                                widget="radio" 
                                options="{'horizontal': True}" 
                                attrs="{'readonly': [('state','!=','draft')],'invisible':[('payment_method_code', '!=', 'check_printing')]}"/>    
                        </group>
                        
                        <group name="payment_right">
                            <field name="amount_total" 
                                widget="monetary"
                                style="font-size: 16px; font-weight: bold; color: #2E7D32;"
                                attrs="{'readonly': ['|',('is_multiple_payment', '=', True),('state','!=','draft')]}"/>
                                
                            <field name="memo" 
                                placeholder="Ingrese notas adicionales sobre el pago..." 
                                required="1"
                                attrs="{'readonly': [('state','!=','draft')]}"/>
                            <field name="check_amount_in_words"
                                    attrs="{'invisible': [('payment_method_code', '!=', 'check_printing')]}"
                                />
                        </group>
                    </group>

                    <!-- LÍNEAS DE CUENTAS POR COBRAR -->
                    <notebook attrs="{'invisible': [('is_multiple_payment','=',False)]}" style="margin-top: 5px;">
                        <page string="Líneas de Cuentas por Pagar" name="receivable_lines">
                            <field name="line_ids" 
                                widget="payment_supplier_widget" 
                                context="{'default_partner_id': partner_id}"
                                options='{"no_open": True}'
                                nolabel="1">
                                <tree limit="10000" 
                                    string="Líneas de Cuentas por Pagar" 
                                    editable="bottom" 
                                    create="true" 
                                    delete="true"  
                                    decoration-success="balance &gt; 0" 
                                    decoration-danger="balance &lt; 0"
                                    decoration-info="cuentas_por_pagar == True">
                                    
                                    <field name="sequence" widget="handle"/>
                                    <field name="is_discount_line" invisible="1"/>
                                    <field name="suitable_invoice_line_ids" invisible="1"/>
                                    
                                    <!-- Cliente -->
                                    <field name="partner_id" 
                                        string="Cliente" 
                                        domain="[('parent_id', '=', False)]" 
                                        attrs="{'readonly': [('is_discount_line','=',True)]}"
                                        options='{"no_open": True,"no_create": 1, "no_create_edit": 1}'
                                        width="120px"/>
                                    
                                    <!-- Línea contable/Documento -->
                                    <field name="account_move_line_id" 
                                        options='{"no_open": True,"no_create": 1, "no_create_edit": 1}' 
                                        attrs="{'readonly': [('is_discount_line','=',True)]}"
                                        string="Documento" 
                                        domain="[('id', 'in', suitable_invoice_line_ids)]"
                                        width="150px"/>
                                    
                                    <!-- Información del documento -->
                                    <field name="move_name" 
                                        force_save="1" 
                                        string="Número Doc." 
                                        attrs="{'readonly': [('is_discount_line','=',True)]}"
                                        readonly="1"
                                        optional="hide"
                                        width="120px"/>
                                        
                                    <field name="date" 
                                        force_save="1" 
                                        string="Fecha" 
                                        optional="hide"
                                        attrs="{'readonly': [('is_discount_line','=',True)]}"
                                        readonly="1"
                                        width="100px"/>
                                    
                                    <!-- Cuenta contable -->
                                    <field name="account_id" 
                                        options='{"no_open": True,"no_create": 1, "no_create_edit": 1}' 
                                        attrs="{'readonly': [('is_discount_line','=',True)]}"
                                        string="Cuenta"
                                        width="120px"/>
                                    
                                    <!-- Centro de costo -->
                                    <field name="analytic_account_id" 
                                        force_save="1" 
                                        attrs="{'readonly':['|',('account_move_line_id','!=',False),('is_discount_line','=',True)]}" 
                                        required="1" 
                                        options='{"no_open": True,"no_create": 1, "no_create_edit": 1}'
                                        string="Centro Costo"
                                        width="120px"/>
                                    
                                    <!-- Descripción -->
                                    <field name="description" 
                                        required="1" 
                                        string="Descripción"
                                        width="200px"/>
                                    

                                    <field name="discount" 
                                        attrs="{'column_invisible': [('parent.apply_discount', '=', False)],'readonly': ['|',('is_discount_line','=',True),('debit','=',0.00)]}" 
                                        avg="Promedio Descuento" 
                                        force_save="1"/>

                                    <field name="value_discount" 
                                        attrs="{'column_invisible': [('parent.apply_discount', '=', False)],'readonly': ['|',('is_discount_line','=',True),('debit','=',0.00)]}" 
                                        sum="Total" 
                                        force_save="1"/>

                                    <!-- Valores monetarios -->
                                    <field name="debit" 
                                        string="Débito" 
                                        widget="monetary" 
                                        attrs="{'readonly': [('is_discount_line','=',True)]}"
                                        sum="Total Débito"
                                        width="100px"/>
                                        
                                    <field name="credit" 
                                        string="Crédito" 
                                        attrs="{'readonly': [('is_discount_line','=',True)]}"
                                        widget="monetary" 
                                        sum="Total Crédito"
                                        width="100px"/>
                                    
                                    <!-- Información adicional (opcional) -->
                                    <field name="tax_base_amount" 
                                        force_save="1" 
                                        string="Base Gravable" 
                                        optional="hide" 
                                        attrs="{'readonly': [('is_discount_line','=',True)]}"
                                        widget="monetary" 
                                        sum="Total Base"
                                        width="100px"/>
                                        
                                    <field name="balance" 
                                        optional="hide" 
                                        string="Balance" 
                                        sum="Balance Total" 
                                        force_save="1" 
                                        widget="monetary" 
                                        readonly="1"
                                        width="100px"/>

                                    <field name="price_subtotal" 
                                        optional="hide" 
                                        sum="Subtotal Total" 
                                        force_save="1" 
                                        widget="monetary" 
                                        readonly="1"
                                        width="100px"/>
                                        
                                    <field name="amount_residual" 
                                        optional="hide" 
                                        string="Saldo Pendiente"  
                                        force_save="1" 
                                        widget="monetary" 
                                        readonly="1"
                                        width="110px"/>
                                    
                                    <!-- Campos invisibles necesarios -->
                                    <field name="currency_id" invisible="1"/>
                                    <field name="cuentas_por_pagar" invisible="1"/>
                                </tree>
                            </field>
                            
                        </page>                     
                    </notebook>
                </sheet>
                
                <!-- Chatter -->
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>


    <!-- Vista de Búsqueda -->
    <record id="view_supplier_payment_receipt_search" model="ir.ui.view">
        <field name="name">supplier.payment.receipt.search</field>
        <field name="model">supplier.payment.receipt</field>
        <field name="arch" type="xml">
            <search string="Buscar Comprobantes de Egreso">
                <field name="name" string="Número"/>
                <field name="partner_id" string="Cliente"/>
                <field name="journal_id" string="Diario"/>
                <field name="store_id" string="Sucursal"/>
                <separator/>
                <filter string="Mis Recibos" name="my_receipts" domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter string="Borradores" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmados" name="posted" domain="[('state', '=', 'posted')]"/>
                <filter string="Cancelados" name="cancel" domain="[('state', '=', 'cancel')]"/>
                <separator/>
                <filter string="Hoy" name="today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Este Mes" name="this_month" 
                        domain="[('date', '&gt;=', context_today().strftime('%Y-%m-01')), ('date', '&lt;=', context_today().strftime('%Y-%m-31'))]"/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Cliente" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Diario" name="group_journal" context="{'group_by': 'journal_id'}"/>
                    <filter string="Fecha" name="group_date" context="{'group_by': 'date'}"/>
                    <filter string="Sucursal" name="group_store" context="{'group_by': 'store_id'}"/>
                    <filter string="Creado por" name="group_create_uid" context="{'group_by': 'create_uid'}"/>
                </group>
                <searchpanel>
                    <field name="store_id" icon="fa-sitemap" enable_counters="1"/>
                </searchpanel>                     
            </search>
        </field>
    </record>


    <!-- ========== ACCIONES ========== -->

    <!-- Acción Principal -->
    <record id="action_supplier_payment_receipt" model="ir.actions.act_window">
        <field name="name">Comprobantes de Pago</field>
        <field name="res_model">supplier.payment.receipt</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_supplier_payment_receipt_search"/>
        <field name="context">{'search_default_my_receipts': 1 ,'search_default_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un nuevo recibo de pago de Proveedor
            </p>
            <p>
                Los recibos de pago te permiten registrar los pagos de tus Proveedor
                de manera organizada y vincularlos automáticamente con sus cuentas por pagar pendientes.
            </p>
        </field>
    </record>


    <!-- Acción para Clientes (Solo Lectura) -->
    <record id="action_partners_supplier_readonly" model="ir.actions.act_window">
        <field name="name">Proveedores</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Vista de Proveedor (solo consulta)
            </p>
            <p>
                Aquí puedes consultar la información de tus Proveedor.
            </p>
        </field>
    </record>

    <!-- Acción para Facturas de Cliente (Solo Lectura) -->
    <record id="action_supplier_invoices_readonly" model="ir.actions.act_window">
        <field name="name">Facturas de Proveedor</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('move_type', '=', 'in_invoice')]</field>
        <!-- <field name="context">{'create': False, 'edit': False, 'delete': False}</field> -->
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Vista de facturas de cliente (solo consulta)
            </p>
            <p>
                Aquí puedes consultar las facturas emitidas a tus Proveedor.
            </p>
        </field>
    </record>

