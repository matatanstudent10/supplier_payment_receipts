<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="action_template_bancolombia" model="ir.actions.report">
            <field name="name">CHEQUE BANCOLOMBIA</field>
            <field name="model">supplier.payment.receipt</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">supplier_payment_receipts.report_bancolombia</field>
            <field name="report_file">supplier_payment_receipts.report_bancolombia</field>
            <field name="print_report_name">object.name or 'CHEQUE'</field>
            <field name="binding_model_id" ref="model_supplier_payment_receipt"/>
            <field name="binding_type">report</field>
        </record>
        
        <record id="template_bancolombia_paperformat" model="report.paperformat">
            <field name="name">Cheque Bancolombia Format</field>
            <field name="default" eval="False"/>
            <field name="format">custom</field>
            <field name="page_height">182</field> <!-- Tamaño carta altura en mm -->
            <field name="page_width">310</field>  <!-- Tamaño carta ancho en mm -->
            <field name="orientation">Portrait</field>
            <field name="margin_top">0</field>
            <field name="margin_bottom">0</field>
            <field name="margin_left">0</field>
            <field name="margin_right">0</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="dpi">96</field>
            <field name="report_ids" eval="[(6,0,[ref('action_template_bancolombia')])]"/>
        </record>
    </data>
    
    <template id="report_bancolombia">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="page" style="position: relative; width: 216mm; height: 182mm; margin: 0; padding: 0; font-size: 18px; font-family: sans-serif; page-break-after: auto; page-break-inside: avoid;">
                   
                    <!-- FECHA - Separada en AÑO, MES, DIA -->
                    <!-- Año -->
                    <div style="position: absolute; top: 24mm; left: 217mm; font-size: 18px; font-weight: bold; width: 12mm; text-align: center; font-family: sans-serif;">
                        <span t-esc="o.payment_id.date.strftime('%Y')"/>
                    </div>
                   
                    <!-- Mes -->
                    <div style="position: absolute; top: 24mm; left: 236mm; font-size: 18px; font-weight: bold; width: 12mm; text-align: center; font-family: sans-serif;">
                        <span t-esc="o.payment_id.date.strftime('%m')"/>
                    </div>
                   
                    <!-- Día -->
                    <div style="position: absolute; top: 24mm; left: 252mm; font-size: 18px; font-weight: bold; width: 12mm; text-align: center; font-family: sans-serif;">
                        <span t-esc="o.payment_id.date.strftime('%d')"/>
                    </div>
                   
                    
                    <!-- MONTO con asteriscos de relleno -->
                    <div style="position: absolute; top: 24mm; left: 275mm; font-size: 20px; font-weight: bold; width: 260mm; text-align: left; overflow: hidden; white-space: nowrap; font-family: sans-serif;">
                        <t t-set="amount_str" t-value="'{:,.2f}'.format(o.payment_id.amount).replace(',', '.').replace('á','a').replace('é','e').replace('í','i').replace('ó','o').replace('ú','u').replace('ñ','n').replace('Á','A').replace('É','E').replace('Í','I').replace('Ó','O').replace('Ú','U').replace('Ñ','N')"/>
                        <t t-set="amount_max_chars_num" t-value="21"/>
                        <t t-set="amount_formatted" t-value="amount_str[:amount_max_chars_num]"/>
                        <span t-esc="amount_formatted"/><span t-esc="'*' * (amount_max_chars_num - len(amount_formatted))"/>
                    </div>



                    <!-- <div style="position: absolute; top: 39mm; left: 87mm; font-size: 11px; font-weight: bold; width: 184mm; overflow: hidden; white-space: nowrap;"> -->
                    <!-- PÁGUESE A LA ORDEN DE -->
                    <div style="position: absolute; top: 31mm; left: 102mm; font-size: 17px; font-weight: bold; width: 245mm; height: 16mm; overflow: hidden; font-family: sans-serif;">
                        <t t-set="provider_max_chars" t-value="165"/>
                        <!-- Reemplazar tildes en el nombre del proveedor -->
                        <t t-set="provider_name_raw" t-value="(o.partner_id.name or '')"/>
                        <t t-set="provider_name_clean" t-value="provider_name_raw.replace('á','a').replace('é','e').replace('í','i').replace('ó','o').replace('ú','u').replace('ñ','n').replace('Á','A').replace('É','E').replace('Í','I').replace('Ó','O').replace('Ú','U').replace('Ñ','N')"/>
                        <t t-set="provider_name" t-value="provider_name_clean[:provider_max_chars]"/>
                        <t t-set="provider_remaining_chars" t-value="provider_max_chars - len(provider_name)"/>
                        
                        <!-- Nombre en un span sin wrap, asteriscos en otro span que sí puede hacer wrap -->
                        <span style="white-space: nowrap;" t-esc="provider_name"/><!--
                        --><span style="word-break: break-all;" t-esc="'*' * max(0, provider_remaining_chars)"/>
                    </div>
                    
                    <!-- CANTIDAD EN LETRAS con asteriscos inline -->
                    <div style="position: absolute; top: 46mm; left: 82mm; font-size: 17px; font-weight: bold; width: 280mm; height: 20mm; overflow: hidden; word-wrap: break-word; line-height: 1.2; font-family: sans-serif;">
                        <t t-set="amount_max_chars" t-value="145"/>
                        <!-- Reemplazar tildes en el texto original -->
                        <t t-set="amount_words_raw" t-value="(o.check_amount_in_words or '')"/>
                        <t t-set="amount_words_clean" t-value="amount_words_raw.replace('á','a').replace('é','e').replace('í','i').replace('ó','o').replace('ú','u').replace('ñ','n').replace('Á','A').replace('É','E').replace('Í','I').replace('Ó','O').replace('Ú','U').replace('Ñ','N')"/>
                        <t t-set="amount_words" t-value="amount_words_clean[:amount_max_chars]"/>
                        <t t-set="amount_remaining_chars" t-value="amount_max_chars - len(amount_words)"/>
                        
                        <!-- Texto Y asteriscos en la misma línea -->
                        <span t-esc="amount_words"/><span t-esc="'*' * max(0, amount_remaining_chars)"/>
                    </div>

                    <!-- CANTIDAD EN LETRAS con asteriscos de relleno -->   
                    <!-- <div style="position: absolute; top: 43mm; left: 44mm; font-size: 11px; font-weight: bold; width: 199mm; overflow: hidden; white-space: nowrap;">
                        <t t-set="amount_max_chars" t-value="135"/>
                        <t t-set="amount_words" t-value="(o.check_amount_in_words or '')[:amount_max_chars]"/>
                        <t t-set="amount_remaining_chars" t-value="amount_max_chars - len(amount_words)"/>
                        <span t-esc="amount_words"/><span t-esc="'*' * max(0, amount_remaining_chars)"/>
                    </div> -->

                    <div style="position: absolute; top: 66mm; left: 56mm; font-size: 18px; font-weight: bold; width: 12mm; text-align: center; font-family: sans-serif;">
                        <span>************************************</span>
                    </div>

                    <div style="position: absolute; top: 110mm; left: 300mm; text-align: center;">
                        <t t-if="o.sellos == 'crossed'">
                            <img src="https://www.empaquetadurasyempaques.com/web/image/3142004-a0107ee7/cruzado.png" style="width: 50mm; height: 22mm;"/>
                        </t>
                        <t t-if="o.sellos == 'beneficiary'">
                            <img src="https://www.empaquetadurasyempaques.com/web/image/3142010-d65fb5ff/beneficiario.png" style="width: 50mm; height: 17mm;"/>
                        </t>
                    </div>

                    <div style="position: absolute; top: 164mm; left: 55mm; font-size: 24px; font-weight: bold; width: 12mm; text-align: center; font-family: sans-serif;">
                        <span t-esc="o.name"/>
                    </div>


                   
                    <!-- Línea para referencia visual (opcional - puedes comentarla) -->
                    <!--
                    <div style="position: absolute; top: 35mm; left: 0; width: 210mm; height: 1px; background: red; opacity: 0.3;"></div>
                    <div style="position: absolute; top: 47mm; left: 0; width: 210mm; height: 1px; background: blue; opacity: 0.3;"></div>
                    -->

                    <!-- TABLA DE FACTURAS DE REFERENCIA (máximo 10 líneas) -->
                    <div style="position: absolute; top: 185mm; left: 70mm; width: 156mm; height: 80mm; font-size: 14px; font-family: sans-serif;">
                        <table style="width: 100%; border-collapse: collapse; font-size: 18px; font-family: sans-serif;">
                            <thead>
                                <tr style="border-bottom: 1px solid #000;">
                                    <th style="width: 30%; text-align: left; padding: 2px; font-weight: bold;">Factura</th>
                                    <th style="width: 35%; text-align: left; padding: 2px 6px; font-weight: bold;">Descripcion</th>
                                    <th style="width: 17%; text-align: left; padding: 2px; font-weight: bold;">Debito</th>
                                    <th style="width: 18%; text-align: right; padding: 2px; font-weight: bold;">Credito</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="line_count" t-value="0"/>
                                <t t-foreach="o.line_ids" t-as="line">
                                    <t t-if="line_count &lt; 10">
                                        <tr>
                                            <td style="padding: 1px 2px; border-bottom: 1px dotted #ccc; font-size: 18px; text-align: left;">
                                                <t t-set="invoice_name_clean" t-value="(line.account_move_line_id.move_name or '').replace('á','a').replace('é','e').replace('í','i').replace('ó','o').replace('ú','u').replace('ñ','n').replace('Á','A').replace('É','E').replace('Í','I').replace('Ó','O').replace('Ú','U').replace('Ñ','N')"/>
                                                <span t-esc="invoice_name_clean"/>
                                            </td>
                                            <td style="padding: 1px 6px 1px 2px; border-bottom: 1px dotted #ccc; font-size: 18px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-align: left;">
                                                <t t-set="ref_clean" t-value="(line.description or '').replace('á','a').replace('é','e').replace('í','i').replace('ó','o').replace('ú','u').replace('ñ','n').replace('Á','A').replace('É','E').replace('Í','I').replace('Ó','O').replace('Ú','U').replace('Ñ','N')"/>
                                                <span t-esc="ref_clean"/>
                                            </td>
                                            <td style="padding: 1px 2px; border-bottom: 1px dotted #ccc; text-align: right; font-size: 18px;">
                                                <t t-set="debit_clean" t-value="'{:,.2f}'.format(line.debit).replace(',', '.').replace('á','a').replace('é','e').replace('í','i').replace('ó','o').replace('ú','u').replace('ñ','n').replace('Á','A').replace('É','E').replace('Í','I').replace('Ó','O').replace('Ú','U').replace('Ñ','N')"/>
                                                <span t-esc="debit_clean"/>
                                            </td>
                                            <td style="padding: 1px 2px; border-bottom: 1px dotted #ccc; text-align: right; font-size: 18px;">
                                                <t t-set="credit_clean" t-value="'{:,.2f}'.format(line.credit).replace(',', '.').replace('á','a').replace('é','e').replace('í','i').replace('ó','o').replace('ú','u').replace('ñ','n').replace('Á','A').replace('É','E').replace('Í','I').replace('Ó','O').replace('Ú','U').replace('Ñ','N')"/>
                                                <span t-esc="credit_clean"/>
                                            </td>
                                        </tr>
                                        <t t-set="line_count" t-value="line_count + 1"/>
                                    </t>
                                </t>
                            </tbody>
                        </table>
                    </div>



                   
                </div>
            </t>
        </t>
    </template>
</odoo>